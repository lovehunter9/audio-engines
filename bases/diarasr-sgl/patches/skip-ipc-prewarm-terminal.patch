+def may_send_out_of_process(stage_spec: StageLaunchConfig) -> bool:
+    """Whether the stage can hand a payload or stream to a stage in another process.
+
+    Only such a hand-off exports CUDA IPC. A process that never exports must not
+    prewarm either: managed allocations, as under GPU time slicing, have no IPC
+    handle, and the prewarm alone would fail the stage.
+    """
+    if stage_spec.route_fn is not None:
+        return True
+    else:
+        pass
+    next_stages = stage_spec.next_stages
+    if next_stages is None:
+        targets: set[str] = set()
+    elif isinstance(next_stages, str):
+        targets = {next_stages}
+    else:
+        targets = set(next_stages)
+    targets.update(stage_spec.stream_targets)
+    return bool(targets - stage_spec.same_process_targets)
