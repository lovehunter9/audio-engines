# audio-nemo base: NVIDIA NeMo runtime for Streaming Sortformer (diar_stream).
#
# This base has NO Dockerfile on purpose. The upstream image is 25.7 GB
# compressed / ~55 GB unpacked, and a docker build must unpack all of it to run a
# single COPY — more than a GitHub-hosted runner's whole disk. The presence of
# this file switches both CI and `make build-push` to scripts/append-image.sh,
# which appends the wrapper as a layer through the registry instead. Read that
# script's header before changing anything here.
#
# Consequence: NOTHING can be installed at build time, so the upstream image must
# already provide every import wrapper/caps/diar_stream.py makes. It does —
# fastapi, uvicorn, numpy, torch and nemo_toolkit all live in the image's own uv
# venv at /opt/venv (NOT the system python, which has torch but no nemo).
BASE_IMAGE=docker.io/beclab/nvidia-nemo:26.02
PLATFORM=linux/amd64
AUDIO_PYTHON=/opt/venv/bin/python
