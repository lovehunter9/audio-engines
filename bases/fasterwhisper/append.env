# audio-fasterwhisper appends the wrapper to its deps image (bases/fasterwhisper/deps.Dockerfile).
# No AUDIO_PYTHON here: the deps image bakes /usr/local/bin/audio-python from the interpreter probe.
PLATFORM=linux/amd64
# First use of a transformers-format model converts it to CT2, which is legitimate multi-GB work.
EXTRA_ENV=LOAD_TIMEOUT_S=5400
